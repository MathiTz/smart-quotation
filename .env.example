# Postgres (docker-compose maps container 5432 -> host 5433 to avoid clashing
# with a locally installed Postgres)
DATABASE_URL=postgresql://sq:sq@localhost:5433/smart_quotation

# --- Model provider -----------------------------------------------------------
# Models are named "provider/model". Set the two model ids below to whichever
# provider you have a key for and fill in only that provider's key; the app
# decides it is online based on the provider the model ids name, so an unused
# provider's key can stay blank.
#
#   google/gemini-2.5-flash        openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-5    ollama/gpt-oss:120b
NEGOTIATION_MODEL=ollama/gpt-oss:120b
PARSER_MODEL=ollama/gpt-oss:120b

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama Cloud — https://ollama.com/settings/keys
# Leave OLLAMA_BASE_URL unset for the hosted service. For a local Ollama set it
# to http://localhost:11434/v1 and leave the key blank; local needs no auth.
# Note the /v1 suffix: /api is Ollama's native API, /v1 is the OpenAI-compatible
# one this app talks to.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=

# Left unset on purpose, so the app decides: offline when the provider named
# above has no key, online when it does. That default is what lets a fresh clone
# run with no account at all.
#
#   SQ_OFFLINE=1   always use the deterministic stubs
#   SQ_OFFLINE=0   always use live models. If the provider above has no key the
#                  API prints what is missing and refuses to start, rather than
#                  failing every call into the stubs and looking like it worked.
#
# Tests set this themselves and ignore whatever is here.
#SQ_OFFLINE=

# How long one agent call may take before the offline stub answers instead.
# Worth raising if you are running a slow model locally.
MODEL_TIMEOUT_MS=60000

API_PORT=8787
